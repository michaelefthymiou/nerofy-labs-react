# PayFast configuration.
#
# Copy this file to `.env` for local testing with `netlify dev`.
# NEVER commit the real `.env` — it is gitignored.
#
# In production these are set in Netlify:
#   Site settings → Environment variables

# "sandbox" (test payments, no real money) or "live"
PAYFAST_MODE=sandbox

# Leave these blank while PAYFAST_MODE=sandbox — PayFast's public
# sandbox credentials are used automatically.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
