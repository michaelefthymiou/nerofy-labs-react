# Copy to .env only if you test functions locally with `netlify dev`.
# On the live site these are set in Netlify: Project configuration > Environment variables.

# "sandbox" for test payments, "live" for real money
PAYFAST_MODE=sandbox

# Leave blank in sandbox mode; PayFast's public test merchant is used.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# Google Sheet web app (stock, order log, order emails). See apps-script/SETUP.md
GOOGLE_SCRIPT_URL=
ORDER_SECRET=
